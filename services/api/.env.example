# Use a managed PostgreSQL database. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/outlay
PGSSL=require
OUTLAY_ADMIN_TOKEN=replace-with-at-least-32-random-characters
OUTLAY_CONTRACT_ID=outlay-deployer.testnet
NEAR_TESTNET_RPC_URL=https://rpc.testnet.fastnear.com
PORT=8787
